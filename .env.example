# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Database (Supabase connection string, used by Prisma)
DATABASE_URL=

# Mesaj client API
MESAJ_API_BASE_URL=https://api.mesaj.cloud:25274
MESAJ_API_TOKEN=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Email (transactional)
RESEND_API_KEY=
EMAIL_FROM=noreply@mesajsme.com

# Error monitoring (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
